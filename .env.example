# BioTrace environment configuration.
# Copy to .env and edit. NEVER commit the real .env file.

# --- Core ---
BIOTRACE_ENV=development
BIOTRACE_HOST=127.0.0.1
BIOTRACE_PORT=8000
BIOTRACE_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/biotrace.db

# Comma-separated list of allowed browser origins for CORS.
# For local development the frontend is served by the same FastAPI app,
# so same-origin requests do not need CORS. Add entries only if you host
# the frontend separately.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Admin review console ---
# Set a strong password before exposing the admin console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# --- Uploads ---
MAX_UPLOAD_MB=8
UPLOAD_DIR=./data/uploads

# --- AI ---
# Directory containing plant/ and bird/ model artifacts.
MODEL_DIR=./models
# Optional: absolute path or URL to the class-name map, defaults to model_card.json
# BIOTRACE_MODEL_VERSION=demo-mobilenetv3-v1

# --- External services (all optional, all free) ---
# Nominatim requires a descriptive User-Agent and <=1 request/second.
# Set a unique application name and a real contact address before bulk imports.
# Example: NOMINATIM_USER_AGENT=BioTrace/1.0 (you@your-domain)
NOMINATIM_USER_AGENT=BioTrace-Academic-Project/1.0
# Set to 1 to enable the optional live Wikipedia summary enrichment.
WIKIPEDIA_ENRICHMENT=0
